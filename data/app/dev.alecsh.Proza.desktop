[Desktop Entry]
Type=Application
Name=Proza
GenericName=Text Editor
Comment=A lightweight plain-text editor, modelled on CotEditor
Exec=proza %U
Icon=dev.alecsh.Proza
Terminal=false
Categories=Utility;TextEditor;GTK;
Keywords=text;editor;plain;code;
MimeType=text/plain;text/markdown;text/x-python;text/x-csrc;text/x-chdr;text/x-c++src;text/x-rust;text/x-shellscript;text/css;text/html;text/xml;application/xml;application/json;application/x-yaml;inode/directory;
StartupNotify=true
StartupWMClass=dev.alecsh.Proza
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=proza
